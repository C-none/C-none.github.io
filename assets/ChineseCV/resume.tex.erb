% Generated from resume.yml by build.rb. Do not edit this file directly.
\documentclass{resume}
\XeTeXgenerateactualtext=1
<% if chinese? -%>
\usepackage[UTF8,fontset=fandol]{ctex}
\titleformat{\section}{\Large\raggedright}{}{0em}{}[\titlerule]
<% end -%>
\usepackage{linespacing_fix}
\usepackage[unicode,hidelinks,bookmarks=false]{hyperref}
\titlespacing*{\section}{0pt}{10pt}{4pt}
\setlength{\emergencystretch}{2em}

\begin{document}
\pagenumbering{gobble}

<% if chinese? -%>
\centerline{\Huge <%= localize(profile.fetch("name")) %>}
\vspace{1.2ex}
<% else -%>
\name{<%= localize(profile.fetch("name")) %>}
<% end -%>
\begin{center}
  \sffamily\large
  <%= email_link(profile.fetch("email")) %>
  \textperiodcentered\ <%= hyperlink(profile.fetch("website"), website_label) %>
  \textperiodcentered\ <%= wechat_contact %>
\end{center}
\vspace{0.5ex}

\section{<%= heading(:education) %>}
<% resume.fetch("education").each do |entry| -%>
\datedsubsection{<%= education_title(entry) %>}{<%= date_range(entry) %>}
<% end -%>

\section{<%= heading(:experience) %>}
<% resume.fetch("experience").each do |entry| -%>
\datedsubsection{\textbf{<%= experience_title(entry) %>}}{<%= date_range(entry) %>}
\begin{itemize}[parsep=0.15ex]
<% entry.fetch("bullets").each do |bullet| -%>
  \item <%= localize(bullet) %>
<% end -%>
\end{itemize}
<% end -%>

\section{<%= heading(:publications) %>}
<% resume.fetch("publications").each do |entry| -%>
\datedsubsection{\textbf{<%= localize(entry.fetch("title")) %>}. \newline
<%= publication_authors(entry.fetch("authors")) %>. \textit{<%= localize(entry.fetch("venue")) %>}.}{<%= format_date(entry.fetch("date")) %>}
\begin{itemize}[parsep=0.15ex]
<% entry.fetch("bullets").each do |bullet| -%>
  \item <%= localize(bullet) %>
<% end -%>
\end{itemize}
<% end -%>

\section{<%= heading(:projects) %>}
<% resume.fetch("projects").each do |entry| -%>
\textbf{<%= localize(entry.fetch("title")) %>}
\begin{itemize}[parsep=0.15ex]
<% entry.fetch("bullets").each do |bullet| -%>
  \item <%= localize(bullet) %>
<% end -%>
\end{itemize}
<% end -%>

\section{<%= heading(:awards) %>}
<% resume.fetch("awards").each do |entry| -%>
\datedsubsection{\textbf{<%= localize(entry.fetch("title")) %>}}{<%= format_dates(entry.fetch("dates")) %>}
<% end -%>

\section{<%= heading(:skills) %>}
\begin{itemize}[parsep=0.15ex]
<% resume.fetch("skills").each do |entry| -%>
  \item \textbf{<%= localize(entry.fetch("label")) %>}: <%= skill_values(entry.fetch("values")) %>
<% end -%>
\end{itemize}

\end{document}
